{
  "name": "skills-hub",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.13.0"
  },
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,worker \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --assets public",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint src vite.config.ts",
    "check:rust": "cargo clippy --manifest-path worker/Cargo.toml --target wasm32-unknown-unknown --locked -- -D warnings",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:rust",
    "format": "prettier --write . && cargo fmt --manifest-path worker/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path worker/Cargo.toml -- --check",
    "build:web": "pnpm typecheck && vite build",
    "build:worker": "cd worker && worker-build --release --locked",
    "build": "pnpm build:web && pnpm build:worker",
    "preview": "wrangler dev --local",
    "deploy:dry-run": "pnpm build:web && wrangler deploy --dry-run",
    "deploy": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
